{
  "project": "DocFlow Internship Assignment",
  "version": "1.0.0",
  "author": "Candidate",
  "description": "Async document processing workflow system built with FastAPI, Celery, Redis, PostgreSQL, and Next.js",
  "stack": {
    "frontend": "Next.js 14 with TypeScript and Tailwind CSS",
    "backend": "FastAPI with SQLAlchemy async",
    "worker": "Celery with Redis broker",
    "database": "PostgreSQL 15",
    "messaging": "Redis Pub/Sub for progress events"
  },
  "features": [
    "Async document upload and processing",
    "Real-time progress tracking via SSE",
    "Redis Pub/Sub for worker-to-app communication",
    "Document review and editing",
    "Finalization workflow",
    "JSON and CSV export",
    "Retry mechanism for failed jobs",
    "Dashboard with search, filter, sort, pagination"
  ],
  "processing_stages": [
    "job_queued",
    "job_started",
    "document_received",
    "document_parsing_started",
    "document_parsing_completed",
    "field_extraction_started",
    "field_extraction_completed",
    "storing_result",
    "job_completed"
  ]
}
