DATABASE_URL=postgresql+asyncpg://docflow:docflow_secret@localhost:5432/docflow_db
SYNC_DATABASE_URL=postgresql://docflow:docflow_secret@localhost:5432/docflow_db
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development

# Application secrets (NOT AI provider keys — users provide Gemini/Groq keys via Settings UI)
SECRET_KEY=docflow-super-secret-key-change-in-production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Supports comma-separated keys for rotation (first key encrypts, all keys decrypt)
ENCRYPTION_MASTER_KEY=
